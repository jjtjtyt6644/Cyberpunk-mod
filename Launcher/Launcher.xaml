<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Night City Trainer" Width="900" Height="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Foreground="#FFE6EDF5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <SolidColorBrush x:Key="Yellow" Color="#FFFCEE0A"/>
        <SolidColorBrush x:Key="Cyan" Color="#FF00F0FF"/>
        <SolidColorBrush x:Key="Dim" Color="#FF8A96AB"/>
        <SolidColorBrush x:Key="Card" Color="#CC10131D"/>
        <SolidColorBrush x:Key="CardBorder" Color="#FF1E2838"/>

        <!-- Yellow call-to-action button with a soft glow -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF08080C"/>
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Pulse" CornerRadius="9" Background="#FFFCEE0A" Opacity="0.22">
                                <Border.Effect>
                                    <BlurEffect Radius="22"/>
                                </Border.Effect>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.18" To="0.50" Duration="0:0:1.6">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                            <Border x:Name="Face" CornerRadius="9" Background="#FFFCEE0A"/>
                            <Border x:Name="Shine" CornerRadius="9" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#66FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Body"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1.025" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Body"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1.025" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Shine"
                                                Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Body"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Body"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Shine"
                                                Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#FF00F0FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Background" Value="#FF3A3D2A"/>
                                <Setter TargetName="Pulse" Property="Visibility" Value="Hidden"/>
                                <Setter Property="Foreground" Value="#FFB8BCA0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiet outlined button -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFB9C4D6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="7" Background="#00FFFFFF"
                                BorderBrush="#FF263247" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#1A00F0FF"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#FF00A8B4"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimise / close buttons in the title bar -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF8A96AB"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="6" Background="#00FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark checkbox with a yellow tick -->
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFB9C4D6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="#FF161B28"
                                    BorderBrush="#FF3A475E" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M3.5,9 L7.5,13 L14.5,5" Stroke="#FFFCEE0A" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Opacity="0"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FFFCEE0A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF00F0FF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8A96AB"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE6EDF5"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="16" CornerRadius="14" Background="#FF090A11"
            BorderBrush="#FF1C2B3A" BorderThickness="1" Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.65" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform Y="20"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         To="0" Duration="0:0:0.6">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,866,546" RadiusX="13" RadiusY="13"/>
            </Grid.Clip>

            <!-- Slow drifting colour glows behind everything -->
            <Canvas IsHitTestVisible="False">
                <Ellipse Width="620" Height="620" Canvas.Left="-240" Canvas.Top="-300" Opacity="0.20">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFCEE0A" Offset="0"/>
                            <GradientStop Color="#00FCEE0A" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="(Canvas.Left)"
                                                     From="-240" To="-90" Duration="0:0:11">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)"
                                                     From="-300" To="-230" Duration="0:0:11">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Ellipse Width="640" Height="640" Canvas.Left="470" Canvas.Top="230" Opacity="0.17">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF00F0FF" Offset="0"/>
                            <GradientStop Color="#0000F0FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="(Canvas.Left)"
                                                     From="470" To="340" Duration="0:0:13">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)"
                                                     From="230" To="170" Duration="0:0:13">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
            </Canvas>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="#01000000">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <Image x:Name="TitleIcon" Width="16" Height="16" Margin="0,0,9,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="NIGHT CITY TRAINER" FontFamily="Bahnschrift, Segoe UI" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#FFB9C4D6"/>
                        <TextBlock Text="  /  LAUNCHER" FontFamily="Bahnschrift, Segoe UI" FontSize="12"
                                   Foreground="#FF5F6B80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <Button x:Name="MinButton" Style="{StaticResource TitleButton}" Content="&#xE921;"
                                ToolTip="Minimise"/>
                        <Button x:Name="CloseButton" Style="{StaticResource TitleButton}" Content="&#xE8BB;"
                                ToolTip="Close"/>
                    </StackPanel>
                </Grid>

                <!-- Main content -->
                <Grid Grid.Row="1" Margin="40,10,40,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: hero and the one button -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,18,0,0">
                            <TextBlock Text="CYBERPUNK 2077  ·  SINGLE-PLAYER TRAINER" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                            <TextBlock Text="NIGHT CITY" FontFamily="Bahnschrift, Segoe UI" FontSize="62"
                                       FontWeight="Bold" Foreground="{StaticResource Yellow}" Margin="-3,8,0,0"/>
                            <TextBlock Text="TRAINER" FontFamily="Bahnschrift, Segoe UI" FontSize="62"
                                       FontWeight="Bold" Foreground="#FFFFFFFF" Margin="-3,-16,0,0"/>
                            <Rectangle Height="3" Width="0" HorizontalAlignment="Left" Margin="0,8,0,0"
                                       Fill="{StaticResource Yellow}">
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="132"
                                                                 BeginTime="0:0:0.35" Duration="0:0:0.7">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>
                            <TextBlock x:Name="Tagline" TextWrapping="Wrap" FontSize="14" LineHeight="21"
                                       Foreground="#FFB9C4D6" Margin="0,18,10,0"
                                       Text="Money, god mode, infinite ammo, vehicles, teleport and more, in one in-game menu."/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,0,14">
                            <CheckBox x:Name="StartupCheck" Style="{StaticResource DarkCheck}" Margin="2,0,0,10"
                                      Content="Start with Windows (keeps the trainer up to date)"/>
                            <CheckBox x:Name="SkipCheck" Style="{StaticResource DarkCheck}" Margin="2,0,0,14"
                                      Content="Auto-skip cutscenes"
                                      ToolTip="Starts a small background helper with PLAY. It holds the skip key during cutscenes while the trainer's Auto Skip switch is on."/>
                            <TextBlock x:Name="Activity" FontSize="12.5" Foreground="#FFB9C4D6" Margin="2,0,0,8"
                                       TextTrimming="CharacterEllipsis" Text="Looking for your game..."/>
                            <Border x:Name="ProgressTrack" Height="6" CornerRadius="3" Background="#FF161B28"
                                    Margin="0,0,0,16" Opacity="0">
                                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFFCEE0A" Offset="0"/>
                                            <GradientStop Color="#FF00F0FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                            <Button x:Name="MainButton" Style="{StaticResource PrimaryButton}" Content="PLEASE WAIT"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <!-- Right: status card -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,18,0,12" CornerRadius="12" Background="{StaticResource Card}"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="22,18,22,14">
                            <StackPanel>
                                <TextBlock Text="STATUS" FontFamily="Bahnschrift, Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="DotGame" Width="9" Height="9" Fill="#FF55607A"
                                             VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="GAME" Style="{StaticResource RowLabel}"/>
                                        <TextBlock x:Name="ValGame" Style="{StaticResource RowValue}" Text="Searching..."/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="DotCet" Width="9" Height="9" Fill="#FF55607A"
                                             VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CYBER ENGINE TWEAKS" Style="{StaticResource RowLabel}"/>
                                        <TextBlock x:Name="ValCet" Style="{StaticResource RowValue}" Text="-"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="DotTrainer" Width="9" Height="9" Fill="#FF55607A"
                                             VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="TRAINER" Style="{StaticResource RowLabel}"/>
                                        <TextBlock x:Name="ValTrainer" Style="{StaticResource RowValue}" Text="-"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="DotUpdate" Width="9" Height="9" Fill="#FF55607A"
                                             VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="UPDATES" Style="{StaticResource RowLabel}"/>
                                        <TextBlock x:Name="ValUpdate" Style="{StaticResource RowValue}" Text="Checking..."/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="#FF1E2838" Margin="0,14,0,12"/>
                                <TextBlock x:Name="Tip" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                           Foreground="{StaticResource Dim}"
                                           Text="In game, open the Cyber Engine Tweaks overlay to show the trainer menu."/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FolderButton" Grid.Column="0" Style="{StaticResource GhostButton}"
                                    Content="Change game folder"/>
                            <Button x:Name="RemoveButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                                    Content="Uninstall"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="2" Margin="40,0,40,0">
                    <Border Height="1" Background="#FF161D2A" VerticalAlignment="Top"/>
                    <TextBlock Text="For single-player saves. Back up your saves before using permanent cheats."
                               FontSize="11" Foreground="#FF5F6B80" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LauncherVersion" FontSize="11" Foreground="#FF5F6B80"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Text="Launcher"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
